# Copy to .env and fill in. Never commit the real .env file.

# REQUIRED. Keep it the same between restarts: a new secret signs everyone out (data is not lost).
# This .env file is read automatically from the project folder. Random string of at least 16 characters used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Where the SQLite file lives. A relative path is resolved against the PROJECT folder (not the folder you
# started the server from), so every start uses the same database. The full path is printed at startup.
# Docker sets this to /data/mealmate.db (a volume). Changing it later means starting with an empty database.
MEALMATE_DB=mealmate.db

# Login token lifetime in minutes (default: 1440 = 24 h)
TOKEN_MINUTES=1440

# Load the built-in ingredients and recipes on first start (1 = yes, 0 = no)
SEED_ON_STARTUP=1

# Optional. USDA FoodData Central API key enables verified food search and
# nutrient imports. Obtain a key from USDA FoodData Central; app works without it.
USDA_FDC_API_KEY=
